import React, { useState } from "react";
import {
  View,
  Text,
  ScrollView,
  TouchableOpacity,
  StyleSheet,
  StatusBar,
  Alert,
} from "react-native";

const players = [
  "Player 01",
  "Player 02",
  "Player 03",
  "Player 04",
  "Player 05",
  "Player 06",
  "Player 07",
  "Player 08",
  "Player 09",
  "Player 10",
];

export default function App() {
  const [page, setPage] = useState("Home");
  const [invited, setInvited] = useState([]);

  const invitePlayer = (name) => {
    setInvited([...invited, name]);
    Alert.alert("BRXZZ ESPORTS", "Invitation prepared for " + name);
  };

  const Header = () => (
    <View style={styles.header}>
      <Text style={styles.logo}>BRXZZ</Text>
      <Text style={styles.subtitle}>E S P O R T S</Text>
    </View>
  );

  return (
    <View style={styles.container}>
      <StatusBar barStyle="light-content" backgroundColor="#090909" />

      <Header />

      <View style={styles.nav}>
        {["Home", "Players", "Matches"].map((item) => (
          <TouchableOpacity
            key={item}
            onPress={() => setPage(item)}
            style={[styles.navButton, page === item && styles.activeNav]}
          >
            <Text style={styles.navText}>{item}</Text>
          </TouchableOpacity>
        ))}
      </View>

      <ScrollView contentContainerStyle={styles.content}>
        {page === "Home" && (
          <>
            <Text style={styles.welcome}>WELCOME TO</Text>
            <Text style={styles.title}>BRXZZ ESPORTS</Text>
            <Text style={styles.description}>
              ONE TEAM. ONE DREAM. ONE VICTORY.
            </Text>

            <View style={styles.card}>
              <Text style={styles.cardTitle}>TEAM MEMBERS</Text>
              <Text style={styles.number}>10</Text>
              <Text style={styles.description}>Free Fire Players</Text>
            </View>

            <TouchableOpacity
              style={styles.mainButton}
              onPress={() =>
                Alert.alert(
                  "BRXZZ ESPORTS",
                  "Team invitation feature is ready for backend connection."
                )
              }
            >
              <Text style={styles.buttonText}>SEND GAME INVITATION</Text>
            </TouchableOpacity>

            <TouchableOpacity
              style={styles.secondaryButton}
              onPress={() => setPage("Players")}
            >
              <Text style={styles.buttonText}>VIEW TEAM PLAYERS</Text>
            </TouchableOpacity>
          </>
        )}

        {page === "Players" && (
          <>
            <Text style={styles.title}>TEAM ROSTER</Text>
            <Text style={styles.description}>10 BRXZZ Players</Text>

            {players.map((player, index) => (
              <View style={styles.player} key={player}>
                <View>
                  <Text style={styles.playerName}>
                    {index + 1}. {player}
                  </Text>
                  <Text style={styles.playerRole}>Team Member</Text>
                </View>

                <TouchableOpacity
                  style={styles.inviteButton}
                  onPress={() => invitePlayer(player)}
                  disabled={invited.includes(player)}
                >
                  <Text style={styles.buttonText}>
                    {invited.includes(player) ? "SENT" : "INVITE"}
                  </Text>
                </TouchableOpacity>
              </View>
            ))}
          </>
        )}

        {page === "Matches" && (
          <>
            <Text style={styles.title}>MATCH CENTER</Text>
            <View style={styles.card}>
              <Text style={styles.cardTitle}>UPCOMING MATCH</Text>
              <Text style={styles.description}>
                No matches scheduled yet.
              </Text>
            </View>
            <Text style={styles.description}>
              Match schedules will appear here.
            </Text>
          </>
        )}
      </ScrollView>

      <Text style={styles.footer}>© BRXZZ ESPORTS</Text>
    </View>
  );
}

